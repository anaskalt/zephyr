# MMC5983MA 3-axis magnetometer configuration options

# Copyright (c) 2026 Anastasios Kaltakis
# SPDX-License-Identifier: Apache-2.0

menuconfig MMC5983MA
	bool "MMC5983MA 3-axis magnetometer"
	default y
	depends on DT_HAS_MEMSIC_MMC5983MA_ENABLED
	select I2C
	help
	  Enable the driver for the MEMSIC MMC5983MA 18-bit AMR magnetometer
	  with built-in SET/RESET degaussing.

if MMC5983MA

choice MMC5983MA_TRIGGER_MODE
	prompt "Trigger mode"
	default MMC5983MA_TRIGGER_NONE
	help
	  Specify the type of triggering used by the driver.

config MMC5983MA_TRIGGER_NONE
	bool "No trigger"

config MMC5983MA_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_MEMSIC_MMC5983MA),int-gpios)
	select MMC5983MA_TRIGGER

config MMC5983MA_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_MEMSIC_MMC5983MA),int-gpios)
	select MMC5983MA_TRIGGER

endchoice

config MMC5983MA_TRIGGER
	bool

config MMC5983MA_THREAD_PRIORITY
	int "Thread priority"
	depends on MMC5983MA_TRIGGER_OWN_THREAD
	default 10
	help
	  Priority of the thread used by the driver to handle interrupts.

config MMC5983MA_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on MMC5983MA_TRIGGER_OWN_THREAD
	default 1024
	help
	  Stack size of the thread used by the driver to handle interrupts.

endif # MMC5983MA
